{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mohoc.local/lesson.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "lessonId": {
      "type": "string",
      "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,99}$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "published"
      ]
    },
    "locale": {
      "const": "vi-VN"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "grade": {
      "enum": [
        6,
        7,
        8,
        9
      ]
    },
    "subject": {
      "const": "math"
    },
    "topicIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,99}$"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "learningObjectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "minItems": 1,
      "maxItems": 100
