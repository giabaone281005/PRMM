    "engine": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "geometry_2d",
            "geometry_3d_web",
            "math_explorer_2d",
            "number_line_2d",
            "fraction_bar_2d",
            "algebra_balance_2d",
            "function_plot_2d",
            "percentage_2d",
            "ratio_2d",
            "coordinate_2d",
            "area_2d",
            "pythagorean_2d",
            "linear_plot_2d"
          ]
        },
        "minRuntimeVersion": {
          "const": "1.0.0"
        },
        "requiredCapabilities": {
          "type": "array",
          "items": {
            "enum": [
              "drag_vertex",
              "measure_angle",
              "show_geometry_annotation",
              "toggle_angle_labels",
              "drag_angle_token",
              "orbit_solid",
              "select_face",
              "fill_layers",
              "measure_volume",
              "adjust_parameter",
              "number_line_drag",
              "fraction_partition",
              "balance_equation",
              "plot_function",
              "percentage_grid",
              "ratio_table",
              "coordinate_plane",
              "rectangle_area",
              "pythagorean",
              "linear_graph"
            ]
          },
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true
        }
      },
      "required": [
        "type",
        "minRuntimeVersion",
        "requiredCapabilities"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "properties": {
        "sceneId": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,99}$"
