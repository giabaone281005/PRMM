                      "type": "number"
                    },
                    "minItems": 2,
                    "maxItems": 2
                  },
                  "draggable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "position",
                  "draggable"
                ],
                "additionalProperties": false
