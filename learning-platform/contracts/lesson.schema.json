  "$defs": {
    "criterion": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "all",
                "any"
              ]
            },
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/criterion"
              },
              "minItems": 1,
              "maxItems": 100
            }
          },
          "required": [
            "op",
            "conditions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "not"
            },
            "condition": {
              "$ref": "#/$defs/criterion"
            }
          },
          "required": [
            "op",
            "condition"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "eq",
                "neq",
                "gt",
                "gte",
                "lt",
                "lte",
                "approx",
                "within"
              ]
            },
            "path": {
              "enum": [
                "metrics.validVertexDragCount",
                "metrics.validVertexDragCountSinceCheckpoint",
                "metrics.snappedAngleTokens",
                "metrics.assembledAngleDegrees",
                "metrics.orbitRadians",
                "metrics.selectedFaces",
                "metrics.filledLayers",
                "metrics.volume",
                "metrics.parameterChangeCount",
                "metrics.parameterChangeCountSinceCheckpoint",
                "metrics.modelError",
                "metrics.modelValue"
