{
  "schemaVersion": "1.0.0",
  "version": 1,
  "status": "draft",
  "locale": "vi-VN",
  "subject": "math",
  "topicIds": [
    "geometry"
  ],
  "learningObjectives": [
    "Khám phá quan hệ hình học bằng thao tác trực tiếp."
  ],
  "lessonId": "grade7-triangle-angle-sum",
  "title": "Bí mật bên trong tam giác",
  "grade": 7,
  "engine": {
    "type": "geometry_2d",
    "minRuntimeVersion": "1.0.0",
    "requiredCapabilities": [
      "drag_vertex",
      "measure_angle",
      "show_geometry_annotation",
      "toggle_angle_labels",
      "drag_angle_token"
    ]
  },
  "scene": {
    "sceneId": "triangle-lab",
    "coordinateSystem": "cartesian_2d",
    "viewport": {
      "width": 360,
      "height": 360
    },
    "objects": [
      {
        "id": "A",
        "kind": "point",
        "position": [
          170,
          65
        ],
        "draggable": true
      },
      {
        "id": "B",
        "kind": "point",
        "position": [
          60,
          240
        ],
        "draggable": true
      },
      {
        "id": "C",
        "kind": "point",
        "position": [
          300,
          240
        ],
        "draggable": true
      },
      {
        "id": "triangle",
        "kind": "polygon",
        "vertexIds": [
          "A",
          "B",
          "C"
        ]
      }
    ],
    "initialState": {
      "angleLabelsVisible": false,
      "dragCount": 0
    }
  },
  "checkpoints": [
    {
      "id": "cp-1",
      "order": 1,
      "instruction": "Kéo một đỉnh. Hình dạng tam giác thay đổi như thế nào?",
      "allowedInteractions": [
        "drag_vertex"
      ],
      "scenePatch": {
        "setState": {
          "angleLabelsVisible": false
        }
      },
      "successCriteria": {
        "op": "gte",
        "path": "metrics.validVertexDragCount",
        "value": 1
      },
      "hints": [
        "Thử thao tác trực tiếp lên hình."
      ],
      "feedback": {
        "success": "Chính xác! Bạn vừa khám phá thêm một điều mới."
      }
    },
    {
      "id": "cp-2",
      "order": 2,
      "instruction": "Kéo đỉnh thêm một lần và quan sát tổng ba góc.",
      "allowedInteractions": [
        "drag_vertex",
        "toggle_angle_labels"
      ],
      "scenePatch": {
        "setState": {
          "angleLabelsVisible": true
        }
      },
      "successCriteria": {
        "op": "gte",
        "path": "metrics.validVertexDragCountSinceCheckpoint",
        "value": 1
      },
      "hints": [
        "Thử thao tác trực tiếp lên hình."
      ],
      "feedback": {
        "success": "Chính xác! Bạn vừa khám phá thêm một điều mới."
      }
    },
    {
      "id": "cp-3",
      "order": 3,
      "instruction": "Kéo cả ba mảnh góc vào dải ghép để tạo một góc bẹt.",
      "allowedInteractions": [
        "drag_angle_token"
      ],
      "scenePatch": {
        "addObjects": [
          {
            "id": "angle-token-0",
            "kind": "angle_token",
            "sourceVertexId": "A"
          },
          {
            "id": "angle-token-1",
            "kind": "angle_token",
            "sourceVertexId": "B"
          },
          {
            "id": "angle-token-2",
            "kind": "angle_token",
            "sourceVertexId": "C"
          }
        ]
      },
      "successCriteria": {
        "op": "all",
        "conditions": [
          {
            "op": "eq",
            "path": "metrics.snappedAngleTokens",
            "value": 3
          },
          {
            "op": "approx",
            "path": "metrics.assembledAngleDegrees",
            "value": 180,
            "tolerance": 0.5
          }
        ]
      },
      "hints": [
        "Kéo từng mảnh góc màu xuống vùng nét đứt. Ba góc ghép thành 180°."
      ],
      "feedback": {
        "success": "Chính xác! Bạn vừa khám phá thêm một điều mới."
      }
    }
  ],
  "completion": {
    "requiredCheckpointIds": [
      "cp-1",
      "cp-2",
      "cp-3"
    ]
  }
}